<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para backup em nuvem nem para outro aparelho: as preferencias guardam tokens. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
