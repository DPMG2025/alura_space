<?xml version="1.0" encoding="utf-8"?>
<!-- Favoritos e recentes vao para o backup; as preferencias com os tokens (config.xml) nao. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="config.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="config.xml" />
    </device-transfer>
</data-extraction-rules>
